# Copy this file to .env (in the NOVA folder) and fill in your own values.
# Never commit the real .env file.

# Required: Groq API key for NOVA's brain. Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: what NOVA calls you (defaults to "Boss")
USER_NAME=Boss
